{
  "name": "binfaedesktopapp",
  "version": "1.0.0",
  "description": "Sistema de Informática e Controle de Estoque BINFAE - Aplicativo Desktop Oficial Windows (.exe)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LucasFerreira198/BinfaeDesktopApp.git"
  },
  "keywords": [
    "binfae",
    "stock",
    "inventory",
    "desktop",
    "electron",
    "windows"
  ],
  "author": "BINFAE TI",
  "license": "ISC",
  "build": {
    "appId": "br.mil.fab.binfae.desktop",
    "productName": "Binfae Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/renderer/icons/icon-512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Binfae Desktop"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
